<% layout('layouts/boilerplate') %>

<div class="row">
  <h1 class="text-center">Edit Campground</h1>
  <div class="col-6 offset-3 mb-5">
    <form
      action="/campgrounds/<%= campground._id %>?_method=PUT"
      method="POST"
      novalidate
      class="validated-form"
      enctype="multipart/form-data"
      onsubmit="disableButton()"
    >
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input
          class="form-control"
          type="text"
          id="name"
          name="campground[name]"
          onkeypress="return blockSpecialChar(event)"
          maxlength="50"
          value="<%= campground.name %>"
          required
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="location">Location</label>
        <input
          class="form-control"
          type="text"
          id="location"
          name="campground[location]"
          onkeypress="return blockSpecialChar(event)"
          maxlength="30"
          value="<%= campground.location %>"
          required
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="image">Add Images </label>
        <input
          class="form-control"
          type="file"
          id="image"
          name="image"
          multiple
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="description">Description</label>
        <textarea
          class="form-control"
          type="text"
          id="description"
          maxlength="200"
          onkeypress="return blockSpecialChar(event)"
          rows="7"
          name="campground[description]"
          required
        >
        
        <%= campground.description %></textarea
        >
      </div>
      <div class="mb-3">
        <% campground.images.forEach(function(img, i) { %>
        <img src="<%=img.url%>" class="img-thumbnail" alt="" />
        <div class="form-check-inline">
          <input
            type="checkbox"
            id="image-<%=i%>"
            name="deleteImages[]"
            value="<%=img.filename%>"
          />
        </div>
        <label for="image-<%=i%>">Delete?</label>
        <% }) %>
      </div>
      <div class="mb-3">
        <button id="editButton" type="submit" class="btn btn-success">
          Update Campground
        </button>
      </div>
    </form>
    <a
      class="text-secondary text-decoration-none"
      href="/campgrounds/<%= campground._id %>"
      ><small>&#8810;Back to Campground</small></a
    >
  </div>
</div>

<script>
  function disableButton() {
    var btn = document.getElementById("editButton");
    btn.disabled = true;
    btn.innerText = "Loading...";
  }
</script>
