<% layout('layouts/boilerplate') %>

<div class="row">
  <h1 class="text-center">New Campground</h1>
  <div class="col-6 offset-3 mb-5">
    <form
      action="/campgrounds"
      method="POST"
      novalidate
      class="validated-form"
      enctype="multipart/form-data"
      onsubmit="disableButton()"
    >
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input
          class="form-control"
          type="text"
          id="name"
          name="campground[name]"
          onkeypress="return blockSpecialChar(event)"
          maxlength="50"
          required
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="location">Location</label>
        <input
          class="form-control"
          type="text"
          id="location"
          name="campground[location]"
          onkeypress="return blockSpecialChar(event)"
          maxlength="30"
          required
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="image">Images </label>
        <input
          class="form-control"
          type="file"
          name="image"
          id="image"
          multiple
          required
        />
      </div>
      <div class="mb-3">
        <label class="form-label" for="description">Description</label>
        <textarea
          class="form-control"
          type="text"
          id="description"
          name="campground[description]"
          rows="7"
          maxlength="200"
          onkeypress="return blockSpecialChar(event)"
          required
        ></textarea>
      </div>
      <div class="mb-3">
        <button id="addButton" type="submit" class="btn btn-success">
          Add Campground
        </button>
      </div>
    </form>
    <a class="text-secondary text-decoration-none" href="/campgrounds"
      ><small>&#8810;All Campgrounds</small>
    </a>
  </div>
</div>

<script>
  function disableButton() {
    var btn = document.getElementById("addButton");
    btn.disabled = true;
    btn.innerText = "Loading...";
  }
</script>
